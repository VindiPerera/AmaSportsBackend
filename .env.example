APP_NAME=AmaX
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=amasports
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Mobile app uses Bearer tokens (Sanctum PATs), not cookie sessions, so this
# is only relevant if a web/admin dashboard is added later.
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

# Comma-separated list of allowed origins for CORS, or * for any.
CORS_ALLOWED_ORIGINS=*

# Firestore live-score push (admin panel -> live_scores/{matchId}, the same
# collection sport-mobile/src/services/firebaseService.ts listens to). Leave
# blank in local/dev: FirebaseLiveScoreService degrades gracefully (logs a
# warning, admin panel shows a non-blocking banner) when unset. To enable,
# drop a Firebase service-account JSON at
# storage/app/private/firebase-service-account.json and set only
# FIREBASE_PROJECT_ID (leave FIREBASE_CREDENTIALS_PATH unset to use that
# default path, or set an ABSOLUTE path to store the key elsewhere).
FIREBASE_PROJECT_ID=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# "sync" sends OTP emails immediately with no queue worker required.
# Switch to "database" (and run `php artisan queue:work`) once you're
# ready to queue notifications properly.
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Use "log" locally (emails are written to storage/logs/laravel.log) or
# configure a real SMTP provider (Mailtrap, SES, etc.) for OTP delivery.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@amasports.app"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# PayPal Orders API v2 (hosted checkout) — powers the $10/year player
# subscription and the $5/match admin live-stream unlock. Get sandbox
# credentials from https://developer.paypal.com/dashboard/applications.
# PAYPAL_WEBHOOK_ID comes from registering a webhook (event: all, or at
# least CHECKOUT.ORDER.APPROVED + PAYMENT.CAPTURE.*) pointing at
# {APP_URL}/api/paypal/webhook — required for signature verification, so
# webhook events are silently rejected until it's set.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=USD

# Dev-only: set true to skip the "active subscription required" gate
# (sport-profile saves + Add Sport/Analysis paywall) without a PayPal
# sandbox purchase. Ignored outside APP_ENV=local/testing either way.
SUBSCRIPTION_BYPASS=false

VITE_APP_NAME="${APP_NAME}"
